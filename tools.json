[
  {
    "annotations": {
      "destructiveHint": false,
      "title": "Create transcoding job"
    },
    "description": "Create a transcoding job. Reads a source video from a URL (gs://, s3://, or https://) and produces one or more output renditions. Outputs are written to a storage origin you own (pass output_origin_id); to produce a hosted, playable video instead, use create_video_from_url. Returns the job id, status, and a per-output pricing/status summary. Validation (codec x container compatibility, limits, required fields) is performed server-side and surfaced as a machine-readable error.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "input_url": {
          "description": "Source video to transcode. Supported schemes: gs:// (Google Cloud Storage), s3:// (S3-compatible), https://.",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Arbitrary string key/value pairs echoed back on the job.",
          "type": "object"
        },
        "output_origin_id": {
          "description": "Storage origin (ori_...) to write outputs to. Required unless the job targets managed hosting; a job without it is rejected with output_origin_id required.",
          "type": "string"
        },
        "outputs": {
          "description": "Output renditions to produce (1-10).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "format": {
                "description": "Container or packaging format: mp4, webm, mkv, mov, hls, dash, or adaptive.",
                "type": "string"
              },
              "path": {
                "description": "Output path template override for this rendition (e.g. \"{job_id}/{output_id}/video.mp4\").",
                "type": "string"
              },
              "preset": {
                "description": "Preset applied to this output as a base (id like pst_xxx or slug). Overrides the job-level preset; the fields above override the preset.",
                "type": "string"
              },
              "quality_tier": {
                "description": "Quality tier: economy, standard (default), or premium. Higher tiers cost more.",
                "type": "string"
              },
              "resolution": {
                "description": "Target resolution: 480p, 720p, 1080p, 1440p, 2160p, or 4320p. Omit to keep the source resolution or inherit from a preset.",
                "type": "string"
              },
              "video_codec": {
                "description": "Video codec: h264 (default), h265, vp9, or av1. Must be compatible with the chosen format.",
                "type": "string"
              }
            },
            "required": [
              "format"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "preset": {
          "description": "Preset applied to every output as a base (id like pst_xxx or slug like gaming_1080p_60_standard). Per-output fields override it.",
          "type": "string"
        },
        "priority": {
          "description": "Scheduling priority: economy, standard (default), or premium. Does not affect cost.",
          "type": "string"
        },
        "webhook_url": {
          "description": "HTTPS endpoint to receive job lifecycle webhook events (job.completed, job.failed, ...).",
          "type": "string"
        }
      },
      "required": [
        "input_url",
        "outputs"
      ],
      "type": "object"
    },
    "name": "create_job",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "object": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "estimated_cost": {
                "type": [
                  "null",
                  "number"
                ]
              },
              "format": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status",
              "format"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "status": {
          "type": "string"
        },
        "total_estimated_cost": {
          "type": [
            "null",
            "number"
          ]
        },
        "video_id": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "id",
        "object",
        "status",
        "currency",
        "outputs",
        "created_at"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": false,
      "title": "Ingest and host video"
    },
    "description": "Ingest a remote https:// video and host it in one call — this is the tool for \"transcode and host this, give me a link\". Downloads the URL, transcodes it into an adaptive streaming ladder, and returns a hosted video (vid_...) with status \"processing\". The URL must be publicly reachable over http(s); private/internal targets are rejected (SSRF protection). Visibility follows the app's hosting default, \"unlisted\" when the app has not set one (playable by anyone with the link, not listed publicly). Enables managed hosting for the app on first use — a one-way change, after which hosted storage and egress bill at the standard rates. To finish the job: poll get_video with the returned id every ~10s until status is \"ready\" (typically under a few minutes for a short clip), then give the user playback.player_url — that is the durable, clickable link.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "Longer description for the hosted video.",
          "type": "string"
        },
        "preset": {
          "description": "Preset (id like pst_xxx or slug) driving the transcode. Omit to use the app's default adaptive ladder.",
          "type": "string"
        },
        "tags": {
          "description": "Freeform tags to attach to the video.",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "title": {
          "description": "Display title for the hosted video.",
          "type": "string"
        },
        "url": {
          "description": "Publicly reachable https:// source video to ingest. Private/internal hosts are rejected (SSRF protection).",
          "type": "string"
        },
        "visibility": {
          "description": "Access level: public, unlisted, or private. Omit to use the app's hosting default visibility (unlisted if the app has not set one).",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "name": "create_video_from_url",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "duration_seconds": {
          "type": [
            "null",
            "number"
          ]
        },
        "encoding_cost": {
          "type": [
            "null",
            "number"
          ]
        },
        "id": {
          "type": "string"
        },
        "job_id": {
          "type": [
            "null",
            "string"
          ]
        },
        "object": {
          "type": "string"
        },
        "output_storage_prefix": {
          "type": "string"
        },
        "playback": {
          "additionalProperties": false,
          "description": "Where to watch this video. Present once status is \"ready\"; absent while it is still processing. Contains player_url (durable page to hand a human, public/unlisted only) and hls_url with expires_at (short-lived manifest for your own player).",
          "properties": {
            "expires_at": {
              "description": "RFC 3339 time at which hls_url stops working. Absent when hls_url is unsigned and durable. Does not apply to player_url.",
              "type": "string"
            },
            "hls_url": {
              "description": "HLS manifest (master.m3u8) for embedding in your own player. Signed and short-lived when the delivery zone uses token auth — see expires_at. Fetch a fresh one via get_video rather than storing it.",
              "type": "string"
            },
            "player_url": {
              "description": "Durable, shareable player page for this video. Present for public and unlisted videos; never for private ones (the player page does not serve them). Never expires.",
              "type": "string"
            }
          },
          "type": [
            "null",
            "object"
          ]
        },
        "poster_url": {
          "type": [
            "null",
            "string"
          ]
        },
        "ready_at": {
          "type": [
            "null",
            "string"
          ]
        },
        "renditions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "bitrate_kbps": {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": [
                  "null",
                  "integer"
                ]
              },
              "codec": {
                "type": "string"
              },
              "height": {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": [
                  "null",
                  "integer"
                ]
              },
              "id": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "size_bytes": {
                "type": [
                  "null",
                  "integer"
                ]
              },
              "width": {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": [
                  "null",
                  "integer"
                ]
              }
            },
            "required": [
              "id",
              "resolution",
              "codec"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "status": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
